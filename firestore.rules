rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       USERS COLLECTION
    ===================================================== */

    match /users/{userId} {

      /* ===============================================
         USER CAN READ OWN PROFILE
      =============================================== */

      allow read:
      if request.auth != null
      &&
      request.auth.uid == userId;

      /* ===============================================
         USER CAN CREATE OWN PROFILE
      =============================================== */

      allow create:
      if request.auth != null
      &&
      request.auth.uid == userId;

      /* ===============================================
         USER CAN UPDATE OWN PROFILE
      =============================================== */

      allow update:
      if request.auth != null
      &&
      request.auth.uid == userId;

      /* ===============================================
         DELETE BLOCKED
      =============================================== */

      allow delete:
      if false;

    }

    /* =====================================================
       VISIT LOGS
    ===================================================== */

    match /visit_logs/{logId} {

      /* ===============================================
         USER CAN CREATE OWN VISIT LOG
      =============================================== */

      allow create:
      if request.auth != null;

      /* ===============================================
         USER CAN READ OWN LOGS
      =============================================== */

      allow read:
      if request.auth != null
      &&
      resource.data.uid == request.auth.uid;

      /* ===============================================
         USER CAN UPDATE OWN LOGS
      =============================================== */

      allow update:
      if request.auth != null
      &&
      resource.data.uid == request.auth.uid;

      /* ===============================================
         DELETE BLOCKED
      =============================================== */

      allow delete:
      if false;

    }

    /* =====================================================
       FEEDBACKS
    ===================================================== */

    match /feedbacks/{feedbackId} {

      /* ===============================================
         CREATE FEEDBACK
      =============================================== */

      allow create:
      if request.auth != null;

      /* ===============================================
         READ OWN FEEDBACK
      =============================================== */

      allow read:
      if request.auth != null
      &&
      resource.data.uid == request.auth.uid;

      /* ===============================================
         UPDATE OWN FEEDBACK
      =============================================== */

      allow update:
      if request.auth != null
      &&
      resource.data.uid == request.auth.uid;

      /* ===============================================
         DELETE BLOCKED
      =============================================== */

      allow delete:
      if false;

    }

    /* =====================================================
       ADMIN LOGS
    ===================================================== */

    match /admin_logs/{document=**} {

      allow read, write:

      if request.auth != null
      &&

      request.auth.token.email
      ==
      "its.akshatnetworkhub23@gmail.com";

    }

    /* =====================================================
       ADMIN ACCESS TO USERS
    ===================================================== */

    match /users/{document=**} {

      allow read:

      if request.auth != null
      &&

      request.auth.token.email
      ==
      "its.akshatnetworkhub23@gmail.com";

    }

    /* =====================================================
       ADMIN ACCESS TO VISIT LOGS
    ===================================================== */

    match /visit_logs/{document=**} {

      allow read:

      if request.auth != null
      &&

      request.auth.token.email
      ==
      "its.akshatnetworkhub23@gmail.com";

    }

    /* =====================================================
       ADMIN ACCESS TO FEEDBACKS
    ===================================================== */

    match /feedbacks/{document=**} {

      allow read:

      if request.auth != null
      &&

      request.auth.token.email
      ==
      "its.akshatnetworkhub23@gmail.com";

    }

    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {

      allow read, write:
      if false;

    }

  }

}