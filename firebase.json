{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "hosting": {

    "public": ".",

    "headers": [

      {

        "source": "**/*.js",

        "headers": [

          {

            "key": "Access-Control-Allow-Origin",

            "value": "*"

          },

          {

            "key": "Access-Control-Allow-Methods",

            "value": "GET"

          }

        ]

      }

    ],

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}